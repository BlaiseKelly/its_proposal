@article{matajsHowDoesRoad2026,
  title = {How Does Road Space Allocation Affect the Environment and Health? {{An}} Evaluation Framework for Dynamic and Static Urban Interventions},
  shorttitle = {How Does Road Space Allocation Affect the Environment and Health?},
  author = {Matajs, C. and Baptista, P. and Valença, G. and Félix, R. and Moura, F.},
  date = {2026-06-01},
  journaltitle = {Journal of Transport \& Health},
  shortjournal = {Journal of Transport \& Health},
  volume = {49},
  pages = {102316},
  issn = {2214-1405},
  doi = {10.1016/j.jth.2026.102316},
  url = {https://www.sciencedirect.com/science/article/pii/S2214140526000654},
  urldate = {2026-09-10},
  abstract = {Introduction Road space is increasingly limited and its allocation influences environmental and health outcomes. However, road space management lacks systematic evaluation. It remains unclear whether allocating space dynamically over time has similar environmental and health effects at a street level as traditional approaches. Methods This study develops a replicable methodological framework for assessing environmental and health impacts of urban street space reallocation strategies, applied to both static and dynamic configurations. The methodology is applied to a major street in Lisbon, Portugal. Results Results show that the type of intervention matters most, independently if it is static or dynamic: bike lanes yield the greatest CO2 (up to 16.4\%) and pollutant reductions, while open street scenarios offer the highest health benefits from increased walking. Bus lanes achieve the largest NOx cuts (up to 21.9\%) due to improved bus speeds. Conclusions Although static scenarios perform best environmentally, dynamic solutions - particularly off-peak - achieve comparable results while enhancing flexibility.},
  keywords = {Complex streets,Dynamic road space allocation,Health impact assessment,Scenario-based analysis,Urban space distribution,Vehicle emissions}
}

